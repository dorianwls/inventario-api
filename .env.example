POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Used by ASP.NET Core configuration when running the API locally.
ConnectionStrings__Inventory=Host=localhost;Port=5432;Database=inventario;Username=inventario;Password=replace-with-a-local-password
Jwt__Issuer=Inventario.Api
Jwt__Audience=Inventario.Web
Jwt__SigningKey=replace-with-at-least-32-random-characters
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=replace-with-a-strong-password
BootstrapAdmin__DisplayName=Administrator
